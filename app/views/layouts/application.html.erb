<!DOCTYPE html>
<html>
<head>
  <title>MovieReviewSystem</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <%= stylesheet_link_tag 'application',
        media: 'all',
        'data-turbo-track': 'reload',
        skip_pipeline: true %>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <%= link_to "MovieReviewSystem", movies_path, class: "navbar-brand" %>

    <div class="d-flex">
      <% if user_signed_in? %>
        <span class="text-white me-3 mt-2">
          <%= current_user.email %>
        </span>

        <%= link_to "Movies", movies_path, class: "btn btn-outline-light me-2" %>

        <%= link_to "Add Movie", new_movie_path, class: "btn btn-success me-2" %>

        <%= button_to "Logout",
                      destroy_user_session_path,
                      method: :delete,
                      class: "btn btn-danger",
                      form: { style: "display:inline-block;" } %>

      <% else %>

        <%= link_to "Login",
                    new_user_session_path,
                    class: "btn btn-outline-light me-2" %>

        <%= link_to "Sign Up",
                    new_user_registration_path,
                    class: "btn btn-primary" %>

      <% end %>
    </div>
  </div>
</nav>

<div class="container mt-4">

  <% flash.each do |key, value| %>
    <div class="alert alert-info">
      <%= value %>
    </div>
  <% end %>

  <%= yield %>

</div>

</body>
